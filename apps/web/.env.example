NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:3001/realtime
# Vercel requires explicit public HTTPS/WSS endpoints at build time, without trailing slashes.
# NEXT_PUBLIC_API_URL=https://<render-service-host>/api/v1
# NEXT_PUBLIC_WS_URL=wss://<render-service-host>/realtime
# See docs/24_VERCEL_WEB_DEPLOYMENT.md. Never put database/auth secrets in NEXT_PUBLIC variables.

# Optional production-only error reporting. Public DSN only, never an auth token.
# Empty values disable reporting. NEXT_PUBLIC values require a rebuild.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_APP_RELEASE=
