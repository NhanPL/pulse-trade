NODE_ENV=development
PORT=3001
WEB_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/pulse_trade?schema=public
# Managed PostgreSQL: runtime DATABASE_URL is pooled; migrations use the direct URL.
# Leave unset for local PostgreSQL. Never put a production URL in .env.test.
# DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@DIRECT_HOST/pulse_trade?sslmode=verify-full
# Login requires a random secret of at least 32 characters.
# For local development, run: pnpm --filter @pulse-trade/api auth:setup
# Production must supply its own JWT_ACCESS_SECRET through the deployment environment.
# JWT_ACCESS_SECRET=
