{
  "name": "pulse-trade",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @pulse-trade/web --filter @pulse-trade/api dev",
    "dev:web": "pnpm --filter @pulse-trade/web dev",
    "dev:api": "pnpm --filter @pulse-trade/api dev",
    "build": "pnpm --recursive build",
    "typecheck": "pnpm --recursive typecheck",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.3",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.11.0",
    "prettier": "3.9.6",
    "typescript-eslint": "8.68.0"
  }
}
